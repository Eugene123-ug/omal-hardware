# OMAL ERP — Environment Configuration Template
# Copy this file to .env.development or .env.production and fill in appropriate values.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration — Supabase or Local PostgreSQL
# To use Supabase, provide your Supabase pooled connection string:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:65432/postgres
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Local PostgreSQL Configuration (Fallback when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=omal_business_dev
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security (Phase 2 Auth)
# Generate a random 64-character hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_character_random_hex_secret_key_minimum_32_chars

# Business Identity & Regional Settings
APP_NAME=WONARK ERP
APP_TIMEZONE=Africa/Accra
CURRENCY=GHS

# Resend Email Integration (Forgot & Reset Password)
# 1. Sign up at https://resend.com/
# 2. Generate an API Key under API Keys tab: https://resend.com/api-keys
# 3. For instant testing, use 'onboarding@resend.dev' (sends to your account email).
# 4. In production, verify your custom domain under Domains tab and use 'noreply@yourdomain.com'.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
APP_BASE_URL=https://omal-hardware.vercel.app
